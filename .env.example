# Variables d'environnement — copier ce fichier vers .env.local et renseigner.
# `.env.local` est ignoré par Git (voir .gitignore, règle `.env*`).

# Tableau de bord Supabase > Project Settings > API.
# URL du projet. Exposée au navigateur (préfixe NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=""

# Clé publiable (anon/public). Exposée au navigateur : la sécurité repose sur
# les politiques RLS, pas sur le secret de cette clé.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Clé secrète (secret/service_role). SERVEUR UNIQUEMENT — ne jamais l'exposer
# au navigateur ni l'ajouter en NEXT_PUBLIC_. Utilisée par les scripts de
# maintenance sous `scripts/`, pas par l'application en production.
SUPABASE_SECRET_KEY=""
